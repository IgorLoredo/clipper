# LLM que escolhe os cortes: anthropic | openai | gemini | deepseek | openrouter | ollama
# Lista separada por vírgula = cadeia de fallback (se um acabar a cota/créditos, o próximo assume)
# Ex.: LLM_PROVIDER=anthropic,openai:gpt-5-mini,ollama
# Pode ser trocado por execução com: clipper run ... --llm provedor[:modelo][,...]
LLM_PROVIDER=anthropic

# Modelo padrão de cada provedor (vazio = padrão do clipper)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
DEEPSEEK_MODEL=deepseek-flash
OPENROUTER_MODEL=
OLLAMA_MODEL=

# Chaves (só a do provedor que você usar)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ollama: grátis, roda local (https://ollama.com) -> `ollama pull qwen3:8b`
OLLAMA_URL=http://localhost:11434

# Whisper: vazio = automático (large-v3-turbo com GPU, small em CPU)
WHISPER_MODEL=
WHISPER_DEVICE=

# Detector de rosto: vazio = YuNet baixado automaticamente em ~/.cache/clipper
FACE_MODEL=

# Pasta raiz de saÃ­da (opcional; Ãºtil para manter vÃ­deos grandes fora do OneDrive)
CLIPPER_OUT=
